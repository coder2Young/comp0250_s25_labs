<launch>

	<!-- we will launch with a delay to allow gazebo to load, feel free to edit -->
	<arg name="launch_delay" value="5.0"/>

	<!-- load panda model and gazebo parameters -->
	<include file="$(find panda_description)/launch/description.launch"/>

	<!-- start the coursework world spawner with a delay -->
	<arg name="models_dir" value="$(find cw2_world_spawner)/models/"/>
	<include file="$(find cw2_world_spawner)/launch/world_spawner.launch">
		<arg name="launch_delay" value="$(arg launch_delay)"/>
		<arg name="models_dir" value="$(arg models_dir)"/>
	</include>
	
	<!-- Launch OctoMap server with proper configuration -->
	<node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
		<!-- Connect directly to the depth camera point cloud -->
		<remap from="cloud_in" to="/r200/camera/depth_registered/points" />
		
		<!-- Basic OctoMap parameters -->
		<param name="resolution" value="0.01" />      <!-- 1cm resolution for detailed mapping -->
		<param name="frame_id" value="panda_link0" /> <!-- Use the robot base frame as reference -->
		
		<!-- Filtering parameters -->
		<param name="filter_ground" value="false" />  <!-- Disable automatic ground filtering -->
		<param name="pointcloud_max_z" value="1.5" /> <!-- Maximum height for point cloud points -->
		<param name="pointcloud_min_z" value="0.01" /><!-- Minimum height for point cloud points -->
		
		<!-- OctoMap output parameters -->
		<param name="publish_free_space" value="false" />  <!-- We only need occupied space for our task -->
		<param name="latch" value="true" />               <!-- Latch the published messages -->
		
		<!-- Area bounds to limit memory usage -->
		<param name="occupancy_min_z" value="-0.1" />
		<param name="occupancy_max_z" value="1.5" />
		
		<!-- Performance parameters -->
		<param name="sensor_model/max_range" value="5.0" />  <!-- Maximum sensor range in meters -->
	</node>
	
	<!-- launch the cw solving node, change pkg to your team name here! -->
  <node pkg="cw2_team_6"
        name="cw2_solution_node"
        type="cw2_solution_node"
        output="screen"
  />
  
</launch>
